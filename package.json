{
  "name": "graal-hunt-server",
  "version": "1.0.0",
  "description": "Graal Hunt — WebSocket game server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings 12",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vitest": "5.0.5"
  }
}
